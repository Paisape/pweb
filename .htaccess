Options -Indexes

# Set HTTPS indicator from proxy headers (Cloudflare / Coolify / Traefik)
SetEnvIf X-Forwarded-Proto "^https$" HTTPS=on

# Disable Apache mod_dir trailing slash redirect to eliminate HTTP downgrade loop
DirectorySlash Off

# Serve index.php as default directory file
DirectoryIndex index.php index.html

# Redirect /index.html → / (fixes Google's stale 404)
Redirect 301 /index.html /

# Enable rewrite engine
RewriteEngine On

# Force HTTPS if requested via plain HTTP behind reverse proxy
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Route Microsoft 365 Exchange Daily Banner Requests
RewriteRule ^email-banner\.png$ api/daily-banner.php [L,QSA]
RewriteRule ^assets/email-banner\.png$ api/daily-banner.php [L,QSA]

# Allow actual static files through unchanged (css, js, images, svg, pdf, txt, xml)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route directory or clean URL /slug or /slug/ directly to index.php with zero redirects
RewriteCond %{DOCUMENT_ROOT}/$1/index.php -f
RewriteRule ^(.*)/?$ $1/index.php [L]

RewriteCond %{REQUEST_FILENAME}/index.php -f
RewriteRule ^(.*)/?$ $1/index.php [L]

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
